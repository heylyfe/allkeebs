{
  "name": "allkeebs",
  "version": "1.0.0",
  "description": "Configure lighting, keymaps and macros on keyboards from almost any brand, in the browser over WebHID.",
  "scripts": {
    "build": "node build.mjs",
    "data": "sh tools/fetch-data.sh",
    "build:db": "node tools/build-db.mjs data/via data/qmk src/kbdb.json.gz data/vial data/viamia/keyboards",
    "test": "node test/run.mjs"
  },
  "keywords": [
    "keyboard",
    "webhid",
    "via",
    "vial",
    "qmk",
    "rgb",
    "macros"
  ],
  "author": "heylyfe",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@openmouse/keyboard-protocol": "^1.6.1",
    "esbuild": "^0.24.0",
    "lucide": "^0.468.0",
    "xz-decompress": "^0.2.2"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heylyfe/allkeebs.git"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
