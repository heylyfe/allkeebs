<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-exe": the desktop app's exe, signed before it is
     packaged into the installers. product-name/product-version are enforced, as the SignPath
     Foundation terms require. Paste into SignPath with the slug "app-exe". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="allkeebs.exe" product-name="allkeebs" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
