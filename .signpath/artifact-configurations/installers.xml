<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the NSIS setup exe and the MSI, built around
     the already signed allkeebs.exe. Paste into SignPath with the slug "installers". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="allkeebs_${version}_x64-setup.exe" product-name="allkeebs" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="allkeebs_${version}_x64_en-US.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
