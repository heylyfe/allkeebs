{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "allkeebs",
  "version": "../package.json",
  "identifier": "io.github.heylyfe.allkeebs",
  "build": {
    "frontendDist": "../desktop-dist",
    "beforeBuildCommand": "npm run build:desktop && node tools/crate-notices.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "allkeebs",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://usevia.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Keyboard lighting, keymaps and macros",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "heylyfe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "THIRD_PARTY_CRATES.txt": "THIRD_PARTY_CRATES.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    }
  }
}
